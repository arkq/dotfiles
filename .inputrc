# .inputrc: readline customization

# Load distribution global settings.
$include /etc/inputrc

# Do not play annoying sounds.
set bell-style none

# Use colors when showing tab-completion.
set colored-stats on

# Smart-ass completion mode.
set completion-ignore-case on
set completion-map-case on
set skip-completed-text on
set show-all-if-ambiguous on

# Do not show dot-files on tab-completion by default.
set match-hidden-files off

# History search with "page up" and "page down".
"\e[5~": history-search-backward
"\e[6~": history-search-forward
